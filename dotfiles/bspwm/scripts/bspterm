#!/usr/bin/env bash

## Copyright (C) 2020-2026 Aditya Shakya <adi1090x@gmail.com>
##
## launch kitty with bspwm config

# bspwm directory
DIR="$HOME/.config/bspwm"
CONFIG="$DIR/kitty/kitty.conf"

case "${1:-}" in
	--float) kitty --class kitty-float --config "$CONFIG" ;;
	--full)  kitty --class kitty-fullscreen --config "$CONFIG" \
			--start-as fullscreen \
			--override window_padding_width=30 \
			--override font_size=14 \
			--override background_opacity=0.95 ;;
	*)       kitty --config "$CONFIG" "$@" ;;
esac
